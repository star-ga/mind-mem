// mind-mem architectural-governance rules
//
// Enforced via:
//   arch-mind check-rules --repo . --fixture .arch-mind/last_summary.json \
//                         --rules .arch-mind/rules.mind --mode enforce
//
// Q16.16 fixed-point thresholds in [0, 10000].
//
// How the fixtures are produced (2026-09-01):
//
//     python3 .arch-mind/rescan.py            # rewrite fixture.json,
//                                             # last_summary.json, scan.json
//     python3 .arch-mind/rescan.py --check    # exit 1 if they are stale
//
// That script extracts the commit with `git archive` and scans the
// extraction, so every counter below is a function of the COMMIT and
// never of scan-time filesystem state. Scanning a live checkout is not
// equivalent and must not be used: a `git worktree` checkout below the
// repo root (`.wt/`, `.claude/worktrees/`, any other naming) holds a
// second copy of this source, is untracked here, and appears and
// vanishes as parallel agents run. Measured on commit 6e60759 with one
// binary and two inputs — live checkout vs `git archive` extraction —
// module_count 1302 vs 391, intra_package_edges 77 of 350 vs 77 of 77
// (modularity_q16 2200 vs 10000), and max_mcp_tool_overlap 6 vs 2
// (mcp_tool_isolation 9400 vs 9800). The live-checkout readings were
// artefacts of eight nested checkouts; no threshold below is
// calibrated to them, and none has been moved to accommodate them.
//
// Extraction is deliberately stronger than asking the scanner to prune
// nested trees: pruning depends on which arch-mind build is installed,
// while an extraction of a commit contains tracked files only and so
// cannot contain a nested working tree at all.
//
// Copyright 2026 STARGA, Inc. — Apache-2.0.

[protection]
module mind_mem_rules {

    // ─── locked ─────────────────────────────────────────────────────────

    // Acyclicity is a hard invariant for the recall→propose→approve
    // pipeline; a cycle there means contradiction-safety is broken.
    [arch_rule(acyclicity_q16, eq)]
    const NO_CYCLES: i32 = 10000

    // ─── stage-appropriate floors ───────────────────────────────────────

    // Currently 9904.
    [arch_rule(redundancy_q16, ge)]
    const REDUNDANCY_FLOOR: i32 = 9500

    // Currently 6473 (post-test-filter; Python repo).
    [arch_rule(q16_determinism_purity, ge)]
    const PURITY_FLOOR: i32 = 6000

    // Recalibrated 2026-05-01: current raw=2234. mind-mem is a
    // Python+MIND hybrid where the bulk of the symbol surface lives
    // in src/mind_mem/*.py; the MIND-only sidecar-scan sees only
    // the kernels/ tree, and arch-mind v0.0.4's scanner counts
    // symbols differently from the version that produced the prior
    // 4874 reading. Floor follows the actual hybrid-repo reading
    // with a 200-point safety margin; lift will come when the
    // native-MIND scoring kernels in v3.2.0+ grow the MIND surface.
    [arch_rule(equality_q16, ge)]
    const EQUALITY_FLOOR: i32 = 2000

    // Currently 7000 (longest path = 4).
    [arch_rule(depth_q16, ge)]
    const DEPTH_FLOOR: i32 = 6000

    // Recalibrated 2026-05-10: current raw=0. mind-mem's mind/*.mind
    // files are scoring kernels (BM25, RM3, RRF, hybrid, ranking,
    // recall, intent, query_plan, …) — they don't carry [protection]
    // decl blocks, which is the syntax governance_kernel_coverage
    // counts. Governance in mind-mem lives in Python (audit chain,
    // contradiction detection, quality gate), not MIND modules.
    // Floor follows the actual hybrid-repo reading; lift will come
    // when v4 introduces native-MIND governance kernels (cognitive
    // kernel routing, surprise-weighted retrieval) that emit real
    // [protection] decls. Same pattern as evidence_chain_density
    // below — arch-mind's MIND-only sidecar-scan can't see Python.
    [arch_rule(governance_kernel_coverage, ge)]
    const GOVERNANCE_FLOOR: i32 = 0

    // Verified 10000 on 2026-09-01 against commit 6e60759: all 77
    // architectural dependency edges are intra-package
    // (`intra_package_edges == total_edges`), and an independent walk
    // of the import graph found zero edges whose endpoints sit in
    // different top-level packages.
    //
    // `eq` is NOT a miscalibrated threshold and NOT an unreachable
    // target: the property is measured, and held, on this commit. The
    // comparator is exact because `modularity_q16` truncates — the
    // ratio reaches 10000 only when intra == total — so `eq 10000`
    // means literally "zero cross-package edges", which is what the
    // rule is named after. A repo whose production surface is one
    // package either has that property or has lost it; there is no
    // meaningful 99%-modular state to grant a floor for.
    //
    // Softening it to a floor would also destroy its second,
    // load-bearing job: it is the canary for a scan that measured
    // something other than this repository. A second copy of the tree
    // resolves its imports to the same canonical module names, so every
    // one of those lands as a cross-package edge — 273 of 350 edges
    // when this repo was scanned live on 2026-09-01. It fired
    // correctly; the fix was the input, not the rule.
    //
    // Enforced in CI by tests/test_arch_mind_rules_gate.py, which
    // additionally measures the invariant straight from the import
    // graph so a stale fixture cannot make it look true.
    [arch_rule(modularity_q16, eq)]
    const NO_CROSS_PKG: i32 = 10000

    // Verified 9800 on 2026-09-01 against commit 6e60759: max
    // transitive-dependency overlap is 2 across 40 MCP-tool modules.
    // The kernel is a step function — score = 10000 - 100*overlap — so
    // this floor admits overlap up to 5 and tolerates three more shared
    // dependencies before it bites.
    //
    // THREE pairs sit at 2, all of them sharing infrastructure rather
    // than each other:
    //   mcp.tools.governance / mcp.tools.memory_ops  (block_parser, storage)
    //   mcp.resources        / mcp.tools.recall      (recall, sqlite_index)
    //   mcp.resources        / mcp.tools.memory_ops  (block_parser, sqlite_index)
    //
    // A reading of 9400 is overlap 6, not a near miss on overlap 2:
    // the metric moves in whole units of 100. Every 9400 reading on
    // this repo has come from MCP tool modules paired against copies of
    // THEMSELVES in a nested working tree — on 2026-09-01 the overlap-6
    // pair was src/mind_mem/mcp/tools/memory_ops.py against the copies
    // of that same file in .wt/agent-comm/, .wt/agent-comm-inv/ and
    // .wt/recall-default-bug/, sharing block_parser, corpus_registry,
    // mind_ffi, mind_filelock, sqlite_index and storage. There is no
    // tool-to-tool coupling defect to fix, so the floor stays where it
    // is; the input is what was wrong.
    [arch_rule(mcp_tool_isolation, ge)]
    const MCP_ISOLATION_FLOOR: i32 = 9500

    // Recalibrated 2026-05-01: mind-mem's audit-integrity TAG_v1
    // evidence chain is emitted from Python (src/mind_mem/audit.py);
    // arch-mind v0.0.4's MIND-only sidecar-scan does not see those
    // calls and reports 0. The prior 65 reading was from an older
    // arch-mind version that walked Python AST too. Floor is 0 today;
    // lifts when v3.2.0's native-MIND scoring path emits evidence
    // calls from MIND modules that the current scanner does count.
    [arch_rule(evidence_chain_density, ge)]
    const EVIDENCE_FLOOR: i32 = 0

}
