{
  "name": "@mind-mem/sdk",
  "private": true,
  "version": "0.1.0",
  "description": "JS/TS client SDK for the mind-mem REST API",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && test -f build/test/client.test.js && node --test build/test/*.test.js",
    "clean": "rm -rf dist build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/star-ga/mind-mem.git",
    "directory": "sdk/js"
  },
  "bugs": {
    "url": "https://github.com/star-ga/mind-mem/issues"
  },
  "homepage": "https://github.com/star-ga/mind-mem/tree/main/sdk/js#readme",
  "keywords": [
    "mind-mem",
    "memory",
    "ai",
    "mcp",
    "sdk"
  ],
  "author": "STARGA Inc <noreply@star.ga>"
}
