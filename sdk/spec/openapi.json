{
  "components": {
    "schemas": {
      "ApproveApplyRequest": {
        "properties": {
          "dry_run": {
            "default": true,
            "description": "Dry-run (True) or commit (False)",
            "title": "Dry Run",
            "type": "boolean"
          },
          "proposal_id": {
            "description": "Proposal ID in format P-YYYYMMDD-NNN",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^P-\\d{8}-\\d{3}$",
            "title": "Proposal Id",
            "type": "string"
          }
        },
        "required": [
          "proposal_id"
        ],
        "title": "ApproveApplyRequest",
        "type": "object"
      },
      "CreateAPIKeyRequest": {
        "description": "Request body for POST /v1/admin/api_keys.",
        "properties": {
          "agent_id": {
            "description": "Agent identifier",
            "maxLength": 128,
            "minLength": 1,
            "title": "Agent Id",
            "type": "string"
          },
          "expires_in_days": {
            "default": 90,
            "description": "Key validity in days",
            "maximum": 3650.0,
            "minimum": 1.0,
            "title": "Expires In Days",
            "type": "integer"
          },
          "scopes": {
            "description": "Access scopes",
            "items": {
              "type": "string"
            },
            "title": "Scopes",
            "type": "array"
          }
        },
        "required": [
          "agent_id"
        ],
        "title": "CreateAPIKeyRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ProposeUpdateRequest": {
        "properties": {
          "block_type": {
            "description": "Block type: decision | task",
            "title": "Block Type",
            "type": "string"
          },
          "confidence": {
            "default": "medium",
            "description": "Confidence level: low | medium | high",
            "title": "Confidence",
            "type": "string"
          },
          "rationale": {
            "default": "",
            "description": "Rationale for the proposal",
            "maxLength": 2000,
            "title": "Rationale",
            "type": "string"
          },
          "statement": {
            "description": "The proposal statement",
            "maxLength": 500,
            "minLength": 1,
            "title": "Statement",
            "type": "string"
          },
          "tags": {
            "default": "",
            "description": "Comma-separated tags",
            "maxLength": 500,
            "title": "Tags",
            "type": "string"
          }
        },
        "required": [
          "block_type",
          "statement"
        ],
        "title": "ProposeUpdateRequest",
        "type": "object"
      },
      "RecallRequest": {
        "properties": {
          "active_only": {
            "default": false,
            "description": "Only return active (non-superseded) blocks",
            "title": "Active Only",
            "type": "boolean"
          },
          "backend": {
            "default": "auto",
            "description": "Retrieval backend: auto | bm25 | hybrid",
            "title": "Backend",
            "type": "string"
          },
          "limit": {
            "default": 10,
            "description": "Maximum number of results",
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "description": "Search query",
            "maxLength": 8192,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "scoring_instant": {
            "default": "",
            "description": "UTC date (YYYY-MM-DD) the recency layer scores against. Recall is deterministic given (corpus, config, scoring_instant); pass back the instant a previous run's attestation recorded to replay it. Empty means today in UTC.",
            "maxLength": 10,
            "title": "Scoring Instant",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "RecallRequest",
        "type": "object"
      },
      "RollbackProposalRequest": {
        "properties": {
          "reason": {
            "description": "Why this rollback is being performed. Required for audit trail (issue #510 / N-02).",
            "maxLength": 2000,
            "minLength": 8,
            "title": "Reason",
            "type": "string"
          },
          "receipt_ts": {
            "description": "Receipt timestamp in format YYYYMMDD-HHMMSS",
            "maxLength": 15,
            "minLength": 15,
            "pattern": "^\\d{8}-\\d{6}$",
            "title": "Receipt Ts",
            "type": "string"
          }
        },
        "required": [
          "receipt_ts",
          "reason"
        ],
        "title": "RollbackProposalRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "REST API that mirrors the mind-mem MCP tool surface.",
    "title": "mind-mem REST API",
    "version": "5.0.2"
  },
  "openapi": "3.1.0",
